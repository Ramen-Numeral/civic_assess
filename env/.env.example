# APP_ENV is set by the launch command and selects this file by suffix.
DEBUG=true

# Set to 0 for the local quickstart. Hosted mode requires both credentials.
REQUIRE_AUTHENTICATION=1
GRADIO_USERNAME=
GRADIO_PASSWORD=

SQLITE_DATABASE_PATH=data/civic_assess.sqlite3
CONVERSATION_TTL_MINUTES=30
# Older turns are compacted when raw-turn or context-size limits are exceeded.
CONVERSATION_TURN_RETENTION=8
CONVERSATION_SUMMARIZER_RAW_TURN_COUNT=6

DIVERSIFIED_RESEARCH_QUERY_COUNT=4
RESEARCH_RESULTS_PER_QUERY=5
# Follow-up web rounds after the initial local evidence check.
RESEARCH_MAX_ACQUISITION_ROUNDS=2
TAVILY_TIMEOUT_SECONDS=20

EVIDENCE_EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
EVIDENCE_EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
EVIDENCE_EMBEDDING_BATCH_SIZE=32
EVIDENCE_EMBEDDING_DEVICE=cpu

# Number of candidates to include in the RRF ranking. Larger values increase recall but also latency.
EVIDENCE_LEXICAL_CANDIDATE_COUNT=20
EVIDENCE_SEMANTIC_CANDIDATE_COUNT=20
EVIDENCE_RRF_K=60
# A zero weight disables that retrieval modality; both cannot be zero.
EVIDENCE_RRF_LEXICAL_WEIGHT=1.0
EVIDENCE_RRF_SEMANTIC_WEIGHT=1.0
# Candidate pool size and maximum evidence passed to one coverage check.
EVIDENCE_COVERAGE_CANDIDATE_COUNT=12
EVIDENCE_COVERAGE_CONTEXT_MAX=16
EVIDENCE_MAX_CHUNKS_PER_DOCUMENT=2

# The example TOML activates OpenAI. Add keys for configured fallback providers.
OPENAI_API_KEY=replace-me
GROQ_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=replace-me
